---
import "@fontsource/fira-sans-extra-condensed/800.css";
import "@fontsource/onest/400.css";
import "@fontsource/onest/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import displayFont from "@fontsource/fira-sans-extra-condensed/files/fira-sans-extra-condensed-cyrillic-800-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const favicon = `${base}favicon.svg`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
